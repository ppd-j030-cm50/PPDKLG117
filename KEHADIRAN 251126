<!DOCTYPE html>
<html lang="ms">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sistem Rekod Kehadiran</title>
  <style>
    * {
      box-sizing: border-box;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    body {
      background-color: #f3f4f6;
      margin: 0;
      padding: 20px;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }
    .container {
      background: #ffffff;
      padding: 28px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
      width: 100%;
      max-width: 420px;
    }
    h2 {
      margin-top: 0;
      margin-bottom: 6px;
      color: #111827;
      text-align: center;
    }
    p.subtitle {
      margin-top: 0;
      margin-bottom: 24px;
      color: #6b7280;
      font-size: 14px;
      text-align: center;
    }
    label {
      display: block;
      font-weight: 600;
      font-size: 14px;
      color: #374151;
      margin-bottom: 6px;
    }
    input {
      width: 100%;
      padding: 12px;
      margin-bottom: 16px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      font-size: 15px;
      outline: none;
      transition: border-color 0.2s;
    }
    input:focus {
      border-color: #2563eb;
    }
    button {
      width: 100%;
      padding: 13px;
      background-color: #2563eb;
      color: #ffffff;
      border: none;
      border-radius: 8px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.2s;
    }
    button:hover {
      background-color: #1d4ed8;
    }
    button:disabled {
      background-color: #93c5fd;
      cursor: not-allowed;
    }
    .status {
      margin-top: 16px;
      padding: 12px;
      border-radius: 8px;
      font-size: 14px;
      text-align: center;
      display: none;
    }
    .status.berjaya {
      background-color: #dcfce7;
      color: #166534;
      display: block;
    }
    .status.ralat {
      background-color: #fee2e2;
      color: #991b1b;
      display: block;
    }
  </style>
</head>
<body>

  <div class="container">
    <h2>Rekod Kehadiran</h2>
    <p class="subtitle">Sila lengkapkan maklumat di bawah untuk pengesahan kehadiran.</p>

    <form id="borangKehadiran">
      <label for="nama">Nama Penuh *</label>
      <input type="text" id="nama" name="nama" placeholder="Contoh: Ahmad bin Ali" required>

      <label for="no_ic">No. Kad Pengenalan *</label>
      <input type="text" id="no_ic" name="no_ic" placeholder="Contoh: 900101-01-1234" required>

      <label for="tempat_bertugas">Tempat Bertugas *</label>
      <input type="text" id="tempat_bertugas" name="tempat_bertugas" placeholder="Contoh: SK Taman Sri Kluang" required>

      <label for="jawatan">Jawatan *</label>
      <input type="text" id="jawatan" name="jawatan" placeholder="Contoh: Pegawai Perkhidmatan Pendidikan" required>

      <button type="submit" id="btnHantar">Hantar Kehadiran</button>
    </form>

    <div id="mesejStatus" class="status"></div>
  </div>

  <script>
    // GANTIKAN DENGAN URL WEB APP GOOGLE APPS SCRIPT ANDA
    const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbzT5O82dZn_IyLlcGbEG75KFCi8C8byLbSrYOFGXko1l9zOyku6fXfmxrnQp3P6EZGZ4A/exec";

    const form = document.getElementById("borangKehadiran");
    const btnHantar = document.getElementById("btnHantar");
    const mesejStatus = document.getElementById("mesejStatus");

    form.addEventListener("submit", function (e) {
      e.preventDefault();

      btnHantar.disabled = true;
      btnHantar.textContent = "Sedang menghantar...";
      mesejStatus.className = "status";
      mesejStatus.textContent = "";

      const dataBorang = new FormData(form);

      fetch(SCRIPT_URL, {
        method: "POST",
        body: dataBorang
      })
      .then(response => response.json())
      .then(data => {
        if (data.status === "berjaya") {
          mesejStatus.className = "status berjaya";
          mesejStatus.textContent = "Terima kasih! Kehadiran anda telah berjaya direkodkan.";
          form.reset();
        } else {
          throw new Error(data.mesej || "Ralat tidak diketahui.");
        }
      })
      .catch(error => {
        mesejStatus.className = "status ralat";
        mesejStatus.textContent = "Gagal menghantar data. Sila cuba lagi.";
        console.error("Ralat:", error);
      })
      .finally(() => {
        btnHantar.disabled = false;
        btnHantar.textContent = "Hantar Kehadiran";
      });
    });
  </script>

</body>
</html>
